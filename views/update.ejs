<%- include("partials/header.ejs") %>

<section id="update">

    <% if (typeof updated !=='undefined') { %>
        <% if (updated===true) { %>
            <!-- Customise the Thankyou Message People See when they submit the form: -->
            <div class="top_message">
                <h1 class="comforter-brush-regular">Your post has been update.</h1>
                <h2 class="comforter-brush-regular">You can read your updated post <a href="/read">here</a>.</h2>
            </div>

        <% } else { %>

            <div class="top_message">
                <h1 class="comforter-brush-regular">Sorry, the name and password entered do not match the record.</h1>
                <h2 class="comforter-brush-regular">Go back to "<a href="/read">Read all posts</a>" to try again. </h2>
            </div>

        <% } %>
    <% } else { %>
    
        <div class="top_message">
            <h1 class="comforter-brush-regular top_message">Please fill in your name, password, and the updated message.</h1>
            <h2 class="comforter-brush-regular top_message">Your name and password will need to be matched with those you put in
                the original message.</h2>
        </div>
        <%- include("partials/post.ejs") %>
    
    <% } %>
</section>

<%- include("partials/footer.ejs") %>