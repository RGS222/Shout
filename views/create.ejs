<%- include("partials/header") %>

<section id="create">

    <% if (locals.submitted && submitted==="true") { %>

    <!-- Customise the Thankyou Message People See when they submit the form: -->
    <div class="thankyou_message">
        <h1 class="comforter-brush-regular">Thanks for your post.</h1>
        <h1 class="comforter-brush-regular">You can read your new post <a href="/read">here</a>.</h1>
    </div>

    <% } else { %>

    <h1 class="comforter-brush-regular">Let's have your say written below.</h1>
    <form class="form" autocomplete="off" method="POST" action="/submit">
    
        <div class="form-elements">
            <label for="name">Name: </label>
            <input id="name" name="name" placeholder="What other calls you" />

            <label for="password">Password: </label>
            <input id="password" name="password" type="password" placeholder="You will need this to update or delete your posts" />
        
            <label for="message" style="vertical-align: top;">Message: </label>
            <textarea id="message" name="message" rows="10" placeholder="Tell us what's on your mind..."></textarea>
   
            <button type="submit" class="btn btn-warning">Post</button>
        </div>
    </form>

    <% } %>

</section>

<%- include("partials/footer") %>